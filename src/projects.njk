---
layout: base.njk
title: Projects
description: Projects for personal portfolio website
---

<section id="projects">

  <h1>Projects</h1>

  {% for project in projects %}

  <article class="project-card">

    <h2>
      {{ project.title }}
    </h2>

    <p>
      {{ project.description }}
    </p>

    <p>
      <strong>Role:</strong>
      {{ project.role }}
    </p>

    <p>
      <strong>Technologies:</strong>
      {% for tech in project.technologies %}
        {{ tech }}
        {% if not loop.last %}, {% endif %}
      {% endfor %}
    </p>

  </article>

  {% endfor %}

</section>